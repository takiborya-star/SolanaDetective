# Optional paid or hosted Solana RPC provider. The public mainnet RPC is used otherwise.
SOLANA_RPC_URL=

# Telegram bot settings. Create a bot with @BotFather and set a private chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional X API bearer token for recent mention search.
X_BEARER_TOKEN=

# Optional JSON API endpoint for FOMO Family. The response can be an array
# or an object containing a "tokens" array; see README for accepted fields.
FOMO_FAMILY_API_URL=
